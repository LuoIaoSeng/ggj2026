#container {
    flex-direction: row;
    justify-content: flex-end;
}

#button-list {
    width: 230px;
    flex-grow: 0;
    padding-top: 440px;
}

#r-button, #g-button, #b-button {
    width: 210px;
    height: 200px;
    border-width: 0;
    margin: 0;
    justify-content: center;
    flex-direction: row;
    padding: 0;
    margin-bottom: 10px;
}
#r-button > VisualElement, #g-button > VisualElement, #b-button > VisualElement {
    width: 195px;
    height: 130px;
    flex-grow: 0;
    margin-top: 58px;
}
